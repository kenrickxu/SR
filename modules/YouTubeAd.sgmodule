#!name = YouTube去广告 Original v7 Feed Lean

#!desc = v7列表轻量化：首页/推荐/搜索改用独立wire脚本；播放器及4MiB保护沿用v6。非卡顿修复版，手机内存与播放效果待验，仅启用一份。

#!author = Maasea; Ken SR bounded-entry adaptation

#!homepage=https://github.com/kenrickxu/SR/tree/main/modules/youtube-original

#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png


[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT

[URL Rewrite]
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) _ reject-200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext _ reject-200

[Script]
youtube.response.playback = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(player|get_watch)(\?.*)?$,requires-body=1,max-size=4194304,binary-body-mode=1,script-path=https://sr-config.kt7766.org/modules/youtube-original/youtube.response.v6.js,argument="{"lyricLang":"off","captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":false}"
youtube.response.feeds = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|search)(\?.*)?$,requires-body=1,max-size=1048576,binary-body-mode=1,script-path=https://sr-config.kt7766.org/modules/youtube-original/youtube.feed.v7.js,argument="{"lyricLang":"off","captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":false}"
youtube.response.controls = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(reel\/reel_watch_sequence|guide|account\/get_setting)(\?.*)?$,requires-body=1,max-size=131072,binary-body-mode=1,script-path=https://sr-config.kt7766.org/modules/youtube-original/youtube.response.v6.js,argument="{"lyricLang":"off","captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":false}"

[MITM]
hostname = %APPEND% -redirector*.googlevideo.com,*.googlevideo.com,www.youtube.com,s.youtube.com,youtubei.googleapis.com