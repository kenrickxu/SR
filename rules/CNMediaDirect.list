# Ken5718: compact Apple/media DIRECT exceptions; Push domain/TCP fallbacks stayJP.
# UDP-only9 APNs prefixes cover all17previous media IPs. No Apple TUN/Skip expansion.
DOMAIN,apple-relay.cloudflare.com
DOMAIN,cp4.cloudflare.com
AND,((DOMAIN-SUFFIX,apple.com),(NOT,((DOMAIN-SUFFIX,push.apple.com))))
DOMAIN-SUFFIX,icloud.com
AND,((PROTOCOL,UDP),(OR,((IP-CIDR,17.57.144.0/22),(IP-CIDR,17.188.20.0/23),(IP-CIDR,17.188.128.0/18),(IP-CIDR,17.249.0.0/16),(IP-CIDR,17.252.0.0/16),(IP-CIDR6,2620:149:a44::/48),(IP-CIDR6,2403:300:a42::/48),(IP-CIDR6,2403:300:a51::/48),(IP-CIDR6,2a01:b740:a42::/48))))
